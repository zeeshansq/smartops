DEBUG=False
SECRET_KEY=CHANGE-ME-USE-A-STRONG-RANDOM-KEY-IN-PRODUCTION
IS_PRODUCTION=False
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
CONN_MAX_AGE=60

