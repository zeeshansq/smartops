# =============================================================================
# SmartOps — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in ALL values before running the application.
# NEVER commit .env to version control.
#
# Generate a secret key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# =============================================================================

# ── Django Core ──────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE-ME-USE-A-STRONG-RANDOM-KEY-IN-PRODUCTION
DEBUG=False
IS_PRODUCTION=False

# Comma-separated; no spaces. In production: smartops.nschool.pk
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Database (shared native PostgreSQL, isolated database name) ──────────────
# Local dev (SQLite):
DATABASE_URL=sqlite:///db.sqlite3

# Production (Dedicated Postgres DB 'smartops' on shared Postgres service):
# DATABASE_URL=postgres://smartops:STRONG_PASSWORD@127.0.0.1:5432/smartops

CONN_MAX_AGE=60

# ── Redis & Celery (shared native Redis, isolated database index) ───────────
# Using DB index 1 to avoid collision with existing server projects using DB 0
REDIS_URL=redis://127.0.0.1:6379/1

# ── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_RATE_ANON=20/min
THROTTLE_RATE_USER=200/min

# =============================================================================
# PRODUCTION OVERRIDES — Uncomment and configure for smartops.nschool.pk
# =============================================================================
# IS_PRODUCTION=True
# DEBUG=False
# SECRET_KEY=<generate with command above>
# DATABASE_URL=postgres://smartops:STRONG_PASSWORD@127.0.0.1:5432/smartops
# ALLOWED_HOSTS=smartops.nschool.pk
# CSRF_TRUSTED_ORIGINS=https://smartops.nschool.pk
# REDIS_URL=redis://127.0.0.1:6379/1
