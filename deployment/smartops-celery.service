[Unit]
Description=SmartOps — Celery Async Task Worker
Documentation=https://docs.celeryq.dev
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=forking

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
User=smartops
Group=smartops

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
WorkingDirectory=/var/www/smartops
EnvironmentFile=/var/www/smartops/.env

# ---------------------------------------------------------------------------
# Process
# ---------------------------------------------------------------------------
# -A config.celery   → Celery app defined in config/celery.py
# -c 2               → 2 concurrent workers (conserves RAM on e2-micro)
# -l WARNING         → Only WARNING+ logs in production
# --pidfile          → Required for Type=forking; used by ExecStop
ExecStart=/var/www/smartops/.venv/bin/celery \
    -A config.celery worker \
    --concurrency=2 \
    --loglevel=WARNING \
    --pidfile=/run/celery/worker.pid \
    --logfile=/var/log/smartops/celery.log \
    --detach

ExecStop=/bin/kill -s TERM $(/bin/cat /run/celery/worker.pid)

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
RuntimeDirectory=celery
RuntimeDirectoryMode=0755

# ---------------------------------------------------------------------------
# Reliability
# ---------------------------------------------------------------------------
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=3

# ---------------------------------------------------------------------------
# Security Hardening
# ---------------------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/www/smartops /run/celery /var/log/smartops
ProtectHome=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
